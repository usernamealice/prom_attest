import tkinter as tk
from tkinter import ttk, messagebox
import json
import os
import random

class QuoteGenerator:
    def __init__(self, root):
        self.root = root
        self.root.title("Random Quote Generator")
        self.root.geometry("600x500")
        
        # Файл для сохранения истории
        self.history_file = "quote_history.json"
        
        # Список предопределённых цитат
        self.quotes = [
            {"text": "Знание — сила", "author": "Фрэнсис Бэкон", "topic": "Философия"},
            {"text": "Быть или не быть — вот в чём вопрос", "author": "Уильям Шекспир", "topic": "Литература"},
            {"text": "Делай, что должен, и будь, что будет", "author": "Марк Аврелий", "topic": "Мудрость"},
            {"text": "Мыслю, следовательно, существую", "author": "Рене Декарт", "topic": "Философия"},
            {"text": "Жизнь — это то, что происходит с тобой, пока ты строишь другие планы", "author": "Джон Леннон", "topic": "Жизнь"}
        ]
        
        # История сгенерированных цитат
        self.history = []
        
        self.setup_ui()
        self.load_history()
    
    def setup_ui(self):
        # Основной фрейм
        main_frame = ttk.Frame(self.root, padding="10")
        main_frame.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        # Кнопка генерации
        ttk.Button(main_frame, text="Сгенерировать цитату", command=self.generate_quote).grid(row=0, column=0, pady=10)
        
        # Отображение цитаты
        self.quote_text = tk.Text(main_frame, height=4, wrap=tk.WORD, font=("Arial", 12))
        self.quote_text.grid(row=1, column=0, pady=10, sticky=(tk.W, tk.E))
        
        # Фильтрация
        ttk.Label(main_frame, text="Фильтр по автору:").grid(row=2, column=0, sticky=tk.W)
        self.author_filter = ttk.Combobox(main_frame, state="readonly")
        self.author_filter.grid(row=3, column=0, pady=5, sticky=(tk.W, tk.E))
        self.author_filter.bind("<<ComboboxSelected>>", self.filter_history)
        
        
        ttk.Label(main_frame, text="Фильтр по теме:").grid(row=4, column=0, sticky=tk.W)
        self.topic_filter = ttk.Combobox(main_frame, state="readonly")
        self.topic_filter.grid(row=5, column=0, pady=5, sticky=(tk.W, tk.E))
        self.topic_filter.bind("<<ComboboxSelected>>", self.filter_history)
        
        # Список
        ttk.Label(main_frame, text="История цитат:").grid(row=6, column=0, sticky=tk.W, pady=(10, 0))
        self.history_list = tk.Listbox(main_frame, height=8)
        self.history_list.grid(row=7, column=0, pady=5, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        
        scrollbar = ttk.Scrollbar(main_frame, orient=tk.VERTICAL, command=self.history_list.yview)
        scrollbar.grid(row=7, column=1, sticky=(tk.N, tk.S))
        self.history_list.configure(yscrollcommand=scrollbar.set)


        self.update_filters()
    
    def generate_quote(self):
        """Генерация случайной цитаты"""
        if not self.quotes:
            messagebox.showwarning("Предупреждение", "Список цитат пуст!")
            return
        
        quote = random.choice(self.quotes)
        self.display_quote(quote)
        self.add_to_history(quote)
    
    def display_quote(self, quote):
        """Отображение цитаты в текстовом поле"""
        self.quote_text.delete(1.0, tk.END)
        display_text = f"Текст: {quote['text']}\nАвтор: {quote['author']}\nТема: {quote['topic']}"
        self.quote_text.insert(1.0, display_text)
    
    def add_to_history(self, quote):
        """Добавление цитаты в историю"""
        self.history.append(quote)
        self.history_list.insert(tk.END, f"{quote['author']}: {quote['text'][:50]}...")
        self.save_history()
    
    def update_filters(self):
        """Обновление списков фильтров"""
        authors = sorted(set(q["author"] for q in self.quotes))
        topics = sorted(set(q["topic"] for q in self.quotes))
        
        self.author_filter['values'] = ["Все"] + authors
        self.topic_filter['values'] = ["Все"] + topics
        self.author_filter.set("Все")
        self.topic_filter.set("Все")
    
    def filter_history(self, event=None):
        """Фильтрация истории по выбранным критериям"""
        author_filter = self.author_filter.get()
        topic_filter = self.topic_filter.get()
        
        self.history_list.delete(0, tk.END)
        
        for quote in self.history:
            author_match = (author_filter == "Все" or quote["author"] == author_filter)
            topic_match = (topic_filter == "Все" or quote["topic"] == topic_filter)
            
            if author_match and topic_match:
                self.history_list.insert(tk.END, f"{quote['author']}: {quote['text'][:50]}...")
    
    def save_history(self):
        """Сохранение истории в JSON-файл"""
        try:
            with open(self.history_file, 'w', encoding='utf-8') as f:
                json.dump(self.history, f, ensure_ascii=False, indent=2)
        except Exception as e:
            messagebox.showerror("Ошибка", f"Не удалось сохранить историю: {e}")
    
    def load_history(self):
        """Загрузка истории из JSON-файла"""
        if os.path.exists(self.history_file):
            try:
                with open(self.history_file, 'r', encoding='utf-8') as f:
                    self.history = json.load(f)
                # Обновляем список истории
                for quote in self.history:
                    self.history_list.insert(tk.END, f"{quote['author']}: {quote['text'][:50]}...")
            except Exception as e:
                messagebox.showerror("Ошибка", f"Не удалось загрузить историю: {e}")

# Запуск
if __name__ == "__main__":
    root = tk.Tk()
    app = QuoteGenerator(root)
    root.mainloop()
